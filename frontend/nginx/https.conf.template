# Режим с сертификатом: HTTPS + HTTP/2. С порта 80 — постоянный редирект на HTTPS
# (308, а не 301, чтобы POST-запросы старых клиентов не превращались в GET).
# Исключение: запрос уже пришёл по HTTPS через прокси (Tailscale Funnel/Serve) —
# тогда отдаём сайт, иначе получится бесконечный редирект.
# Редиректы не кэшируем: 308 браузеры и iOS запоминают навсегда, и ошибка в настройке
# продолжала бы действовать даже после исправления. Переменная непуста только у редиректов
# (пустой add_header nginx не отправляет, а обычные ответы сохраняют свои заголовки).
map $fwd_proto $redirect_nocache_80 {
    https   "";
    default "no-store";
}
map $host $redirect_nocache_443 {
    "${PUBLIC_HOST}" "";
    default          "no-store";
}

server {
    listen 80;
    server_name _;
    add_header Cache-Control $redirect_nocache_80 always;
    if ($fwd_proto != "https") {
        return 308 https://${PUBLIC_HOST}$request_uri;
    }
    include /etc/nginx/snippets/app.conf;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Зашли по IP или другому имени — отправляем на имя из сертификата,
    # иначе браузер покажет предупреждение о несовпадении.
    add_header Cache-Control $redirect_nocache_443 always;
    if ($host != "${PUBLIC_HOST}") {
        return 308 https://${PUBLIC_HOST}$request_uri;
    }

    include /etc/nginx/snippets/app.conf;
}
