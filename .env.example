APP_PORT=8080
DATABASE_URL=postgres://studentapp:secret@localhost:5432/discount_db?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
JWT_EXPIRY_MIN=30
ARGON2_TIME=2
ARGON2_MEMORY=65536
ARGON2_THREADS=4
ARGON2_KEY_LEN=32
EMAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user
SMTP_PASSWORD=pass
FRONTEND_URL=http://localhost:3000
IP_HASH_SECRET=change-me-in-production
# HMAC-секрет для подписи платёжных вебхуков и одноразовых checkout-токенов.
# Обязательно задайте свой в продакшене (openssl rand -hex 32).
PAYMENT_WEBHOOK_SECRET=change-me-in-production
# Лимит попыток входа с одного IP в минуту
LOGIN_RATE_LIMIT_PER_MIN=10
